\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \footnotesize  \textbf  {Empirical rejection rates for robust location change-point tests under ARMA(2,1) dependence.} Evaluated under $H_0$ (size), $H_1$ (abrupt break at $u=0.5$), and $H_2$ (gradual linear change) with shift magnitude $\delta = 0.5$ at nominal level $\alpha = 0.05$ (dashed line). Rows represent Clean, AO, and IO with $\varepsilon = 0.05$ scenarios for Gaussian and Student-$t_3$ errors. Methods: \textbf  {L} (Proposed Linearized Welsch CUSUM), \textbf  {H} (Huberized CUSUM; \cite  {huskova2012}), \textbf  {W} (Wilcoxon test; \cite  {Dehling2015}), and \textbf  {T} (Hodges--Lehmann test; \cite  {Dehling2020}). Circle colors represent variance scenarios: smooth trending (blue), cyclic (green), and abrupt break (red). Open circle markers scale with sample size $n \in \{200, 500, 1000\}$.}}{14}{figure.caption.6}\protected@file@percent }
\newlabel{fig:cpd_comparison_matrix}{{1}{14}{\footnotesize \textbf {Empirical rejection rates for robust location change-point tests under ARMA(2,1) dependence.} Evaluated under $H_0$ (size), $H_1$ (abrupt break at $u=0.5$), and $H_2$ (gradual linear change) with shift magnitude $\delta = 0.5$ at nominal level $\alpha = 0.05$ (dashed line). Rows represent Clean, AO, and IO with $\varepsilon = 0.05$ scenarios for Gaussian and Student-$t_3$ errors. Methods: \textbf {L} (Proposed Linearized Welsch CUSUM), \textbf {H} (Huberized CUSUM; \cite {huskova2012}), \textbf {W} (Wilcoxon test; \cite {Dehling2015}), and \textbf {T} (Hodges--Lehmann test; \cite {Dehling2020}). Circle colors represent variance scenarios: smooth trending (blue), cyclic (green), and abrupt break (red). Open circle markers scale with sample size $n \in \{200, 500, 1000\}$}{figure.caption.6}{}}
